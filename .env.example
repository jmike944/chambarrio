# Supabase (live mode). Leave empty to run demo-only on the bundled mock data.
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_…). The legacy anon key also works
# as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site address for link previews (optional; production defaults to https://chambarrio.com).
NEXT_PUBLIC_SITE_URL=

# Outside job boards for "Más vacantes en Saltillo" (server-only, all optional: a board without its
# key is never called; with none, the section doesn't show). See src/lib/external-jobs/providers.ts.
# Jooble: request a key for Mexico at mx.jooble.org/api/about (free key: 100 requests/day).
JOOBLE_API_KEY=
# Only if Jooble gives you another host for that key (default https://mx.jooble.org).
JOOBLE_API_HOST=
# Careerjet: publisher account → API key. It receives each visitor's IP and user agent (required).
# Leave it empty on Vercel: Careerjet only answers servers whose IP is on the account's allowlist,
# and Vercel functions have no fixed outbound IP (unless the paid Static IPs add-on is enabled).
CAREERJET_API_KEY=
