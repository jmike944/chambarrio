# Supabase (live mode). Leave empty to run demo-only on the bundled mock data.
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_…). The legacy anon key also works
# as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site address for link previews (optional; production defaults to https://chambarrio.com).
NEXT_PUBLIC_SITE_URL=
